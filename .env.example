GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=800

# BLIP captioning through Hugging Face Inference API
HUGGINGFACE_API_KEY=
BLIP_MODEL_ID=Salesforce/blip-image-captioning-base

# Energy-based OOD detection
# Calibrate with: python scripts/calibrate_ood_threshold.py --val-dir path/to/validation
OOD_THRESHOLD=
OOD_THRESHOLD_PERCENTILE=95
# OOD dataset directory (optional, only needed if you want to evaluate OOD performance)
OOD_VAL_DIR=
# for data loader in calculating energy scores on the OOD validation set, if OOD_VAL_DIR is set
BATCH_SIZE=16
# model trained from resnet pretrained model, so use imagenet mean and std for normalization in OOD detection
MEAN=[0.485, 0.456, 0.406]
STD=[0.229, 0.224, 0.225]
IMG_SIZE=224



# RAG / vector database
RAG_DATA_DIR=./data-RAG
CHROMA_COLLECTION=agroscan_rag
CHROMA_PERSIST_DIR=./.chroma
# Optional: set CHROMA_HOST/CHROMA_PORT to use the Docker Chroma service instead
CHROMA_HOST=localhost
CHROMA_PORT=8000

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
